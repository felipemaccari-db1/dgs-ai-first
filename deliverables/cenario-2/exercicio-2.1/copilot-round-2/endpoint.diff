diff --git a/src/shared/logger.ts b/src/shared/logger.ts
index e69de29..0d2528e 100644
--- a/src/shared/logger.ts
+++ b/src/shared/logger.ts
@@ -0,0 +1,11 @@
+// Instância única de pino para todo o projeto.
+// Ver AGENTS.md > Coding Standards > Logging:
+// "src/shared/logger.ts DEVE exportar uma única factory/instância de pino para todo o projeto —
+// nenhum outro arquivo em src/ pode chamar pino(...) diretamente."
+//
+// Todo handler/serviço que precisa logar DEVE importar `logger` deste arquivo,
+// nunca instanciar seu próprio logger local.
+
+import pino from "pino";
+
+export const logger = pino({ name: "novatech-assistant" });
